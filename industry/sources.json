{
  "$comment": "国内电商首批信源配置：包含已实测可用的网页列表/RSS（enabled=true）与待补 ghid/Key 的微信公众号及外部推送模板（enabled=false）。字段规范见 docs/sources.md。",
  "sources": [
    {
      "id": "web-pai-home",
      "name": "派代 / 电商派",
      "kind": "web_list",
      "config": {
        "url": "https://www.pai.com.cn/",
        "parseMode": "html",
        "itemSelector": "div:has(> div > h3 > a[href^='/p/'])",
        "linkSelector": "h3 a",
        "titleSelector": "h3 a",
        "allowUrlPrefixes": ["https://www.pai.com.cn/p/"],
        "publishedAtUtcOffset": "+08:00",
        "detail": {
          "maxFetches": 8,
          "publishedAtSelector": "h1 + div > div.text-xs",
          "publishedAtUtcOffset": "+08:00"
        },
        "_aihot": {
          "initialBackfillLimit": 8
        }
      },
      "tier": "T2",
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 60,
      "tags": ["电商垂媒"],
      "site_fulltext": false,
      "syndicate_fulltext": false,
      "enabled": true
    },
    {
